<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>
  <groupId>dev.argontechs</groupId>
  <artifactId>order-saga</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>order-saga</name>
  <properties>
    <java.version>21</java.version>
  </properties>
  <repositories>
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro</artifactId>
        <version>1.12.0</version>
      </dependency>
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-avro-serializer</artifactId>
        <version>7.7.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <modules>
    <module>common-events</module>
    <module>common-messaging</module>
    <module>order-service</module>
    <module>payment-service</module>
    <module>inventory-service</module>
    <module>shipping-service</module>
    <module>e2e-tests</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*IT.java</include>
          </includes>
          <!-- Testcontainers 1.21.0 hardcodes RemoteApiVersion.VERSION_1_32 as a fallback
               whenever DefaultDockerClientConfig can't resolve an api version (it only reads
               the "api.version" system property, not DOCKER_API_VERSION). Local Docker Engine's
               MinAPIVersion is 1.40, so the hardcoded 1.32 request is rejected. Pin a compatible
               version explicitly. -->
          <argLine>-Dapi.version=1.41</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
